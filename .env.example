# ============================================================
# ProjectPlaner – Umgebungsvariablen (Kopie nach .env)
# ============================================================

# --- Datenbank -------------------------------------------------
MYSQL_DATABASE=projectplaner
MYSQL_USER=planer
# Pflicht: sichere Passwörter verwenden (openssl rand -base64 24)
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Für lokale Entwicklung (Host-Zugriff):
DATABASE_URL=mysql://planer:change-me@localhost:3306/projectplaner
# In Containern setzt Compose DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
# (bevorzugt); DATABASE_URL dient dann nur noch Host-Skripten.

# --- API -------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Origin der App (für CORS/Origin-Check). Dev: Vite, Prod: eigene Domain
APP_ORIGIN=http://localhost:5173
# Pflicht: mind. 32 Zeichen (openssl rand -base64 48)
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
# Access-Token-Gültigkeit in Sekunden
ACCESS_TOKEN_TTL=900
# Refresh-Token-Gültigkeit in Tagen
REFRESH_TOKEN_TTL_DAYS=30
# Cookies nur über HTTPS senden (Prod: true, Dev: false)
COOKIE_SECURE=false
# 32 Byte base64 für AES-256-GCM (Outlook-Tokens). openssl rand -base64 32
APP_ENCRYPTION_KEY=
LOG_LEVEL=info

# --- Seed (Admin-Benutzer) -------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234!
SEED_ADMIN_NAME=Administrator
# Demo-Daten mit anlegen (true/false)
SEED_DEMO=true

# --- Microsoft Graph / Outlook ---------------------------------
# Azure-App-Registrierung; Redirect-URI siehe GRAPH_REDIRECT_URI
GRAPH_CLIENT_ID=
# "common" für Multitenant oder Tenant-ID
GRAPH_TENANT_ID=common
GRAPH_CLIENT_SECRET=
GRAPH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/outlook/callback

# --- MCP-Server (apps/mcp) --------------------------------------
# Siehe docs/MCP.md und apps/mcp/README.md. Der MCP-Server liest `PP_*` aus dem
# Prozess-Env (nicht aus dieser Datei für den API-/Worker-Container).
# Zugriffsweg A: Service-Login (voller Lese-/Schreibzugriff)
# PP_API_URL=http://localhost:3000
# PP_EMAIL=
# PP_PASSWORD=
# Zugriffsweg B: SSH-signierte externe API (nur Anlegen)
# PP_KEY_ID=
# PP_PRIVATE_KEY_PATH=./pp_mcp_key.pem   # PKCS#8!
# PP_KEY_TYPE=ssh-ed25519
# PP_PROJECT_ID=
# HTTP-Transport: --http --port 3900; Verifikation über die API
# PP_INTERNAL_URL=http://localhost:3000
# PP_INTERNAL_TOKEN=change-me            # Standard: JWT_SECRET
# PP_MCP_HOST=0.0.0.0
# PP_MCP_PORT=3900

# --- Web / Caddy -----------------------------------------------
# Domain der Installation (Prod). "localhost" nutzt Caddy-internes TLS.
DOMAIN=localhost
ACME_EMAIL=
